<Window x:Class="Labb3_NET22.CreateNewQuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb3_NET22"
        mc:Ignorable="d"
        Title="QUIZ 1337" Height="800" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <Image Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="5" Source="Images\Logo.png" Width="500" Height="200"/>
        <TextBlock x:Name="TextBlockQuizName" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="5" Text="Quiz name?" FontSize="18" HorizontalAlignment="Center" FontFamily="Showcard Gothic"/>
        <TextBox  x:Name="QuizName" Grid.Column="3" Grid.Row="3" Height="25"/>
        <TextBlock Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="5" Text="CATEGORY?" FontSize="18"       HorizontalAlignment="Center" FontFamily="Showcard Gothic"/>
        <TextBox  x:Name="CategoryName" Grid.Column="3" Grid.Row="5" Height="25"/>
        <TextBlock  Grid.Column="1" Grid.Row="6" Grid.ColumnSpan="5" Text="QUESTION:" FontSize="18" HorizontalAlignment="Center" FontFamily="Showcard Gothic"/>
        <TextBox  x:Name="QuestionStatement" Grid.Column="1" Grid.Row="7" Height="25"       Grid.ColumnSpan="5"/>
        <TextBlock Grid.Column="1" Grid.Row="8" Text="ANSWER 1" FontSize="14" HorizontalAlignment="Center" FontFamily="Showcard Gothic"/>
        <TextBlock  Grid.Column="3" Grid.Row="8" Text="ANSWER 2" FontSize="14" HorizontalAlignment="Center" FontFamily="Showcard Gothic"/>
        <TextBlock  Grid.Column="5" Grid.Row="8" Text="ANSWER 3" FontSize="14" HorizontalAlignment="Center" FontFamily="Showcard Gothic"/>
        <TextBox x:Name="Answer1" Grid.Column="1" Grid.Row="9" Height="25"/>
        <TextBox  x:Name="Answer2" Grid.Column="3" Grid.Row="9" Height="25"/>
        <TextBox x:Name="Answer3" Grid.Column="5" Grid.Row="9" Height="25"/>
        <CheckBox x:Name="Checkbox1" Grid.Column="1" Grid.Row="8" Height="15" Width="15" RenderTransformOrigin="0.678,0.503" Margin="185,0,47,0" VerticalAlignment="Center"/>
        <CheckBox  x:Name="Checkbox2" Grid.Column="3" Grid.Row="8" Height="15" Width="15" Margin="209,2,23,0"/>
        <CheckBox  x:Name="Checkbox3" Grid.Column="5" Grid.Row="8" Height="15" Width="15" Margin="185,0,47,0" VerticalAlignment="Center"/>
        <TextBlock  Grid.Column="1" Grid.Row="11" Grid.ColumnSpan="5" Text="CHECK IN THE CORRECT ANSWER!" FontSize="14" HorizontalAlignment="Center" FontFamily="Showcard Gothic"/>
        <Button  x:Name="btnSaveQuestion" Grid.Column="1" Grid.Row="15" Content="SAVE QUESTION" FontSize="18" Width="200" Height="80" Click="btnSaveQuestion_Click" Background="Red" FontFamily="Showcard Gothic" Margin="23,53,24,210"/>
        <Button x:Name="btnSaveQuiz" Grid.Column="3" Grid.Row="15" Content="SAVE QUIZ" FontSize="18" Width="200" Height="80" Click="btnSaveQuiz_Click" Background="#FF21EF10" FontFamily="Showcard Gothic" Margin="23,53,23,210"/>
        <Button x:Name="btnMainMenu" Grid.Column="5" Grid.Row="12" Content="MAIN MENU" FontSize="18" Width="200" Height="80" Click="btnMainMenu_Click" Background="#FF4692E6" FontFamily="Showcard Gothic" Grid.RowSpan="4" Margin="24,53,23,210"/>
    </Grid>
</Window>
