<Window x:Class="Labb3_NET22.PlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb3_NET22"
        mc:Ignorable="d"
        Title="QUIZ 1337" Height="800" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Image Grid.Column="1" Grid.ColumnSpan="5" Source="Images\Logo.png" Margin="81,0,0,70" Width="501" Grid.RowSpan="8"/>

        <TextBlock x:Name="QuestionStatement" Grid.Column="1" Grid.Row="7" Grid.ColumnSpan="5" Height="30" TextWrapping="Wrap" Text="{Binding Statement}" FontFamily="Showcard Gothic" FontSize="16" HorizontalAlignment="Center"/>
        <Button x:Name="btnAnswer1" Grid.Column="3" Grid.Row="15" Height="40" Width="250" Content="{Binding Answers[0]}" Click="btnAnswer1_Click" Margin="0,140,0,372" Background="#FF0693FF" FontFamily="Showcard Gothic" FontSize="16"/>
        <Button x:Name="btnAnswer2" Grid.Column="3" Grid.Row="15" Height="40" Width="250" Content="{Binding Answers[1]}" Click="btnAnswer2_Click" Margin="0,73,0,439" Background="#FFF0FD01" FontFamily="Showcard Gothic" FontSize="16"/>
        <Button x:Name="btnAnswer3" Grid.Column="3" Grid.Row="15" Height="40" Width="250" Content="{Binding Answers[2]}" Click="btnAnswer3_Click" Margin="0,10,0,502" Background="#FF08F742" FontFamily="Showcard Gothic" FontSize="16"/>
        <ProgressBar x:Name="ProgressBar" Grid.Column="3" Grid.Row="15" Height="20" Width="150" Margin="50,213,46,319" />
        <TextBlock x:Name="CorrectQuestions" Grid.Column="2" Grid.Row="10" FontSize="20" TextWrapping="Wrap" Text="{Binding quizStatus}" Margin="5,0,5,20" Grid.ColumnSpan="2"/>

        <Button x:Name="btnStopPlaying" Grid.Column="3" Grid.Row="15" Height="30" Width="200" Content="Stop Quiz" Click="btnStopPlaying_Click" Background="#FFFB1212" FontFamily="Showcard Gothic" FontSize="14"/>
    </Grid>
</Window>
